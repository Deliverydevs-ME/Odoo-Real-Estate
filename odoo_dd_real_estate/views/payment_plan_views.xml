<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_payment_plan_list" model="ir.ui.view">
        <field name="name">re.payment.plan.list</field>
        <field name="model">re.payment.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="installment_count"/>
                <field name="total_percentage" string="Total %"/>
            </list>
        </field>
    </record>

    <record id="view_re_payment_plan_form" model="ir.ui.view">
        <field name="name">re.payment.plan.form</field>
        <field name="model">re.payment.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. 5% Down Payment + 95% over 60 months"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <p class="text-muted">
                        Milestones follow each other. "Starts After" counts months from the previous
                        milestone's last payment (or from the booking date for the first one).
                        Example: 1% down payment, then 99% as 99 monthly payments starting 1 month later.
                    </p>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="milestone_type"/>
                            <field name="percentage" sum="Total"/>
                            <field name="installment_count"/>
                            <field name="interval_months"/>
                            <field name="start_after_months"/>
                            <field name="per_payment_percentage"/>
                        </list>
                    </field>
                    <group>
                        <field name="total_percentage" string="Total %"
                               decoration-danger="total_percentage != 100"/>
                        <field name="installment_count"/>
                    </group>
                    <field name="note" placeholder="Terms and conditions of this plan..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_re_payment_plan" model="ir.actions.act_window">
        <field name="name">Payment Plans</field>
        <field name="res_model">re.payment.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
