<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_territory_list" model="ir.ui.view">
        <field name="name">re.territory.list</field>
        <field name="model">re.territory</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id" widget="many2one_avatar_user"/>
                <field name="team_id"/>
                <field name="agency_count" string="Agencies"/>
            </list>
        </field>
    </record>

    <record id="view_re_territory_form" model="ir.ui.view">
        <field name="name">re.territory.form</field>
        <field name="model">re.territory</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_agencies" type="object" class="oe_stat_button" icon="fa-building">
                            <field name="agency_count" widget="statinfo" string="Agencies"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="manager_id" widget="many2one_avatar_user"/>
                            <field name="team_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_re_territory" model="ir.actions.act_window">
        <field name="name">Territories</field>
        <field name="res_model">re.territory</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
