<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Projects -->
    <record id="view_re_project_list" model="ir.ui.view">
        <field name="name">re.project.list</field>
        <field name="model">re.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="location"/>
                <field name="handover_date"/>
                <field name="unit_count" string="Units"/>
                <field name="available_unit_count" string="Available"/>
                <field name="sold_unit_count" string="Booked / Sold"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_re_project_kanban" model="ir.ui.view">
        <field name="name">re.project.kanban</field>
        <field name="model">re.project</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full" t-if="record.image_1920.raw_value">
                            <field name="image_1920" widget="image" options="{'size': [120, 90]}"/>
                        </aside>
                        <main class="ms-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="location" class="text-muted"/>
                            <div class="mt-1">
                                <field name="available_unit_count"/> available /
                                <field name="unit_count"/> units
                            </div>
                            <field name="state" widget="badge"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_re_project_form" model="ir.ui.view">
        <field name="name">re.project.form</field>
        <field name="model">re.project</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_units" type="object" class="oe_stat_button" icon="fa-building-o">
                            <field name="unit_count" widget="statinfo" string="Units"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Arabian Residence"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="location"/>
                            <field name="launch_date"/>
                            <field name="handover_date"/>
                        </group>
                        <group>
                            <field name="default_payment_plan_id"/>
                            <field name="payment_plan_ids" widget="many2many_tags"/>
                            <field name="product_id" groups="base.group_no_one"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Units" name="units">
                            <field name="unit_ids" context="{'default_project_id': id}">
                                <list editable="bottom">
                                    <field name="building"/>
                                    <field name="name"/>
                                    <field name="floor" optional="show"/>
                                    <field name="unit_type"/>
                                    <field name="area_sqft" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="price" sum="Total"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'available'"
                                           decoration-warning="state in ('reserved', 'booked')"
                                           decoration-info="state == 'sold'"/>
                                    <field name="partner_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_re_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">re.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first off-plan project</p>
            <p>e.g. Arabian Residence, Al Zorah, Meydan.</p>
        </field>
    </record>

    <!-- Units -->
    <record id="view_re_unit_list" model="ir.ui.view">
        <field name="name">re.unit.list</field>
        <field name="model">re.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="building"/>
                <field name="name"/>
                <field name="floor" optional="hide"/>
                <field name="unit_type"/>
                <field name="area_sqft"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="price"/>
                <field name="price_per_sqft" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state in ('reserved', 'booked')"
                       decoration-info="state == 'sold'"/>
                <field name="partner_id" optional="show"/>
                <field name="sale_order_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_re_unit_form" model="ir.ui.view">
        <field name="name">re.unit.form</field>
        <field name="model">re.unit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_block" type="object" string="Block"
                            invisible="state not in ('available', 'reserved')"/>
                    <button name="action_release" type="object" string="Release"
                            invisible="state not in ('reserved', 'blocked', 'booked')"
                            confirm="Make this unit available again?"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,reserved,booked,sold"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="building"/>
                            <field name="name"/>
                            <field name="floor"/>
                            <field name="unit_type"/>
                        </group>
                        <group>
                            <field name="area_sqft"/>
                            <field name="view"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price"/>
                            <field name="price_per_sqft"/>
                            <field name="sale_order_id"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_re_unit_search" model="ir.ui.view">
        <field name="name">re.unit.search</field>
        <field name="model">re.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="building"/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="booked" string="Booked" domain="[('state', '=', 'booked')]"/>
                <filter name="sold" string="Sold" domain="[('state', '=', 'sold')]"/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'unit_type'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_re_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">re.unit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
