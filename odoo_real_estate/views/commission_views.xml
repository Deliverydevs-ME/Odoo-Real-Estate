<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plans -->
    <record id="view_re_commission_plan_list" model="ir.ui.view">
        <field name="name">re.commission.plan.list</field>
        <field name="model">re.commission.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="basis"/>
                <field name="threshold_percentage" invisible="basis != 'threshold'"/>
                <field name="default_rate"/>
            </list>
        </field>
    </record>

    <record id="view_re_commission_plan_form" model="ir.ui.view">
        <field name="name">re.commission.plan.form</field>
        <field name="model">re.commission.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Standard 2%"/></h1></div>
                    <group>
                        <group>
                            <field name="basis" widget="radio"/>
                            <field name="threshold_percentage" invisible="basis != 'threshold'"/>
                        </group>
                        <group>
                            <field name="default_rate"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Specific Rates (most specific rule wins)"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="project_id"/>
                            <field name="unit_type"/>
                            <field name="rate"/>
                            <field name="fixed_amount"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Conditions..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_re_commission_plan" model="ir.actions.act_window">
        <field name="name">Commission Plans</field>
        <field name="res_model">re.commission.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Agreements -->
    <record id="view_re_commission_agreement_list" model="ir.ui.view">
        <field name="name">re.commission.agreement.list</field>
        <field name="model">re.commission.agreement</field>
        <field name="arch" type="xml">
            <list decoration-muted="validity in ('expired', 'inactive')">
                <field name="name"/>
                <field name="agency_id"/>
                <field name="plan_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
                <field name="validity" widget="badge" decoration-success="validity == 'valid'"
                       decoration-danger="validity == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_re_commission_agreement_form" model="ir.ui.view">
        <field name="name">re.commission.agreement.form</field>
        <field name="model">re.commission.agreement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'confirmed'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="agency_id"/>
                            <field name="plan_id"/>
                            <field name="broker_share"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="validity" widget="badge"/>
                        </group>
                    </group>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_re_commission_agreement" model="ir.actions.act_window">
        <field name="name">Commission Agreements</field>
        <field name="res_model">re.commission.agreement</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Commissions -->
    <record id="view_re_commission_list" model="ir.ui.view">
        <field name="name">re.commission.list</field>
        <field name="model">re.commission</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'blocked'" decoration-success="state == 'paid'"
                  decoration-muted="state == 'cancelled'">
                <field name="order_id"/>
                <field name="agency_id"/>
                <field name="broker_id" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="unit_id" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="base_amount" optional="hide"/>
                <field name="rate"/>
                <field name="total_amount" sum="Total"/>
                <field name="collected_percentage" optional="show" widget="progressbar"/>
                <field name="earned_amount" sum="Earned"/>
                <field name="billed_amount" sum="Billed" optional="show"/>
                <field name="paid_amount" sum="Paid" optional="show"/>
                <field name="to_bill_amount" sum="To Bill"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'" decoration-info="state == 'billed'"
                       decoration-warning="state == 'to_bill'" decoration-danger="state == 'blocked'"/>
            </list>
        </field>
    </record>

    <record id="view_re_commission_form" model="ir.ui.view">
        <field name="name">re.commission.form</field>
        <field name="model">re.commission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_bills" type="object" string="Create Vendor Bill" class="btn-primary"
                            invisible="state != 'to_bill'"/>
                    <button name="action_unblock" type="object" string="Unblock" invisible="not blocked"
                            groups="sales_team.group_sale_manager"/>
                    <button name="action_block" type="object" string="Block"
                            invisible="blocked or state in ('paid', 'cancelled')" groups="sales_team.group_sale_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('billed', 'paid', 'cancelled')" groups="sales_team.group_sale_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,to_bill,billed,paid"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not blocked">
                        Blocked: <field name="blocked_reason" readonly="1" class="d-inline"/>
                    </div>
                    <field name="blocked" invisible="1"/>
                    <group>
                        <group string="Sale">
                            <field name="order_id"/>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="unit_id"/>
                            <field name="agency_id"/>
                            <field name="broker_id"/>
                        </group>
                        <group string="Commission">
                            <field name="agreement_id"/>
                            <field name="plan_id"/>
                            <field name="basis"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="base_amount"/>
                            <field name="rate" readonly="billed_amount"/>
                            <field name="fixed_amount" readonly="billed_amount"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <group>
                        <group string="Progress">
                            <field name="collected_percentage" widget="progressbar"/>
                            <field name="earned_amount"/>
                        </group>
                        <group string="Billing">
                            <field name="billed_amount"/>
                            <field name="paid_amount"/>
                            <field name="to_bill_amount"/>
                            <field name="bill_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_re_commission_search" model="ir.ui.view">
        <field name="name">re.commission.search</field>
        <field name="model">re.commission</field>
        <field name="arch" type="xml">
            <search>
                <field name="agency_id"/>
                <field name="order_id"/>
                <field name="project_id"/>
                <filter name="to_bill" string="To Bill" domain="[('state', '=', 'to_bill')]"/>
                <filter name="blocked" string="Blocked" domain="[('blocked', '=', True)]"/>
                <filter name="not_cancelled" string="Not Cancelled" domain="[('cancelled', '=', False)]"/>
                <filter name="group_agency" string="Agency" context="{'group_by': 'agency_id'}"/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_re_commission" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">re.commission</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_cancelled': 1}</field>
    </record>

    <!-- Agency profile: agreements page & smart button -->
    <record id="view_partner_form_re_commission" model="ir.ui.view">
        <field name="name">res.partner.form.re.commission</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="odoo_real_estate.view_partner_form_re"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_re_view_commissions" type="object" class="oe_stat_button" icon="fa-percent"
                        invisible="re_partner_type != 'agency'">
                    <field name="re_commission_count" widget="statinfo" string="Commissions"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='re_brokers']" position="after">
                <page string="Commission" name="re_commission" invisible="re_partner_type != 'agency'">
                    <field name="re_commission_agreement_ids" context="{'default_agency_id': id}">
                        <list>
                            <field name="name"/>
                            <field name="plan_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
                            <field name="validity" widget="badge" decoration-success="validity == 'valid'"
                                   decoration-danger="validity == 'expired'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Sales order smart button -->
    <record id="view_order_form_re_commission" model="ir.ui.view">
        <field name="name">sale.order.form.re.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="odoo_real_estate.view_order_form_re"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_re_view_installments']" position="after">
                <button name="action_re_view_commissions" type="object" class="oe_stat_button" icon="fa-percent"
                        invisible="not re_commission_count">
                    <field name="re_commission_count" widget="statinfo" string="Commission"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
