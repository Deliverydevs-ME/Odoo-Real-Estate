<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_contract_list" model="ir.ui.view">
        <field name="name">re.contract.list</field>
        <field name="model">re.contract</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('expired', 'terminated')">
                <field name="name"/>
                <field name="contract_type" optional="show"/>
                <field name="partner_id"/>
                <field name="agency_id" optional="show"/>
                <field name="project_id"/>
                <field name="unit_id" optional="show"/>
                <field name="contract_date"/>
                <field name="end_date" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="contract_value" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_re_contract_form" model="ir.ui.view">
        <field name="name">re.contract.form</field>
        <field name="model">re.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachments" type="object" class="oe_stat_button" icon="fa-file-pdf-o">
                            <field name="attachment_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Contract number"/></h1></div>
                    <group>
                        <group string="Parties">
                            <field name="contract_type"/>
                            <field name="partner_id"/>
                            <field name="agency_id"/>
                            <field name="broker_id"/>
                        </group>
                        <group string="Property">
                            <field name="project_id"/>
                            <field name="unit_id"/>
                            <field name="property_description"/>
                            <field name="sale_order_id"/>
                        </group>
                        <group string="Dates">
                            <field name="contract_date"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Value">
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="contract_value"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="migration_line_id" invisible="not migration_line_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Terms" name="payment_terms">
                            <field name="payment_terms"/>
                        </page>
                        <page string="Commission" name="commission">
                            <field name="commission_details"/>
                        </page>
                        <page string="License / Registration" name="license">
                            <field name="license_details"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_re_contract_search" model="ir.ui.view">
        <field name="name">re.contract.search</field>
        <field name="model">re.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="agency_id"/>
                <field name="project_id"/>
                <filter name="active_contracts" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="imported" string="Migrated" domain="[('migration_line_id', '!=', False)]"/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                <filter name="group_agency" string="Agency" context="{'group_by': 'agency_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_re_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">re.contract</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
