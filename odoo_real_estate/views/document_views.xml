<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_document_type_list" model="ir.ui.view">
        <field name="name">re.document.type.list</field>
        <field name="model">re.document.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="applies_to"/>
                <field name="is_required"/>
                <field name="requires_expiry"/>
                <field name="reminder_days" invisible="not requires_expiry"/>
                <field name="grace_days" invisible="not requires_expiry"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_re_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">re.document.type</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_re_partner_document_list" model="ir.ui.view">
        <field name="name">re.partner.document.list</field>
        <field name="model">re.partner.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'">
                <field name="partner_id"/>
                <field name="partner_type" optional="show"/>
                <field name="type_id"/>
                <field name="document_number"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('valid', 'no_expiry')"
                       decoration-warning="state in ('expiring', 'missing_date')"
                       decoration-danger="state == 'expired'"/>
                <field name="renewal_state"/>
                <field name="rm_id" widget="many2one_avatar_user"/>
                <field name="attachment_ids" widget="many2many_binary" string="Files" optional="show"/>
                <button name="action_start_renewal" type="object" string="Start Renewal" icon="fa-refresh"
                        invisible="renewal_state not in ('none', 'pending')"/>
            </list>
        </field>
    </record>

    <!-- Opened from the agency / broker smart button: editable, with the files -->
    <record id="view_re_partner_document_list_partner" model="ir.ui.view">
        <field name="name">re.partner.document.list.partner</field>
        <field name="model">re.partner.document</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'">
                <field name="partner_id" string="Agency / Broker"
                       domain="['|', ('id', '=', context.get('default_partner_id')), ('parent_id', '=', context.get('default_partner_id'))]"/>
                <field name="partner_type" optional="show"/>
                <field name="type_id" options="{'no_create': True}"/>
                <field name="document_number"/>
                <field name="issue_date" optional="show"/>
                <field name="requires_expiry" column_invisible="True"/>
                <field name="expiry_date" invisible="not requires_expiry"/>
                <field name="days_to_expiry" invisible="not expiry_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('valid', 'no_expiry')"
                       decoration-warning="state in ('expiring', 'missing_date')"
                       decoration-danger="state == 'expired'"/>
                <field name="renewal_state" optional="show"/>
                <field name="attachment_ids" widget="many2many_binary" string="Files"/>
                <button name="action_start_renewal" type="object" string="Start Renewal" icon="fa-refresh"
                        invisible="renewal_state not in ('none', 'pending') or state not in ('expiring', 'expired')"/>
            </list>
        </field>
    </record>

    <record id="view_re_partner_document_form" model="ir.ui.view">
        <field name="name">re.partner.document.form</field>
        <field name="model">re.partner.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_renewal" type="object" string="Start Renewal"
                            invisible="renewal_state not in ('none', 'pending')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="type_id" options="{'no_create': True}"/>
                            <field name="document_number"/>
                            <field name="rm_id"/>
                        </group>
                        <group>
                            <field name="requires_expiry" invisible="1"/>
                            <field name="issue_date"/>
                            <field name="expiry_date" invisible="not requires_expiry"/>
                            <field name="days_to_expiry" invisible="not expiry_date"/>
                            <field name="renewal_state"/>
                        </group>
                    </group>
                    <field name="attachment_ids" widget="many2many_binary"/>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_re_partner_document_search" model="ir.ui.view">
        <field name="name">re.partner.document.search</field>
        <field name="model">re.partner.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="document_number"/>
                <field name="type_id"/>
                <field name="rm_id"/>
                <filter name="expiring" string="Expiring Soon" domain="[('state', '=', 'expiring')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="renewal_open" string="Renewal Open"
                        domain="[('renewal_state', 'in', ('pending', 'in_progress'))]"/>
                <separator/>
                <filter name="my_agencies" string="My Agencies" domain="[('rm_id', '=', uid)]"/>
                <filter name="group_type" string="Document Type" context="{'group_by': 'type_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_re_partner_document" model="ir.actions.act_window">
        <field name="name">Documents &amp; Renewals</field>
        <field name="res_model">re.partner.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_expiring': 1, 'search_default_expired': 1}</field>
    </record>
</odoo>
