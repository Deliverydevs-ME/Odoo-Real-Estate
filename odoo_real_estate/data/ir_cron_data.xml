<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_document_expiry" model="ir.cron">
        <field name="name">Real Estate: Document Expiry &amp; Renewal Reminders</field>
        <field name="model_id" ref="odoo_real_estate.model_re_partner_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="ir_cron_installments" model="ir.cron">
        <field name="name">Real Estate: Installment Invoicing &amp; Payment Reminders</field>
        <field name="model_id" ref="odoo_real_estate.model_re_installment"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_installments()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
