<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_commission_agreement" model="ir.sequence">
            <field name="name">Commission Agreement</field>
            <field name="code">re.commission.agreement</field>
            <field name="prefix">CA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="product_broker_commission" model="product.product">
            <field name="name">Broker / Agency Commission</field>
            <field name="type">service</field>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="True"/>
        </record>

        <record id="commission_plan_standard" model="re.commission.plan">
            <field name="name">Standard Agency Commission</field>
            <field name="basis">threshold</field>
            <field name="threshold_percentage">10</field>
            <field name="default_rate">2</field>
        </record>
    </data>

    <record id="ir_cron_migration_queue" model="ir.cron">
        <field name="name">Real Estate: Process Migration Queue (OCR / AI)</field>
        <field name="model_id" ref="odoo_real_estate.model_re_migration_line"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_queue()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="action_server_commission_bills" model="ir.actions.server">
        <field name="name">Create Commission Bills</field>
        <field name="model_id" ref="odoo_real_estate.model_re_commission"/>
        <field name="binding_model_id" ref="odoo_real_estate.model_re_commission"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_create_bills()</field>
    </record>
</odoo>
