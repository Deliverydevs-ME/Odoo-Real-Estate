<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_installment_reminder" model="mail.template">
        <field name="name">Real Estate: Installment Reminder</field>
        <field name="model_id" ref="odoo_real_estate.model_re_installment"/>
        <field name="subject">Payment reminder: {{ object.name }} - {{ object.order_id.name }}</field>
        <field name="email_from">{{ (object.order_id.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.partner_id.name or ''">Customer</t>,</p>
    <p t-if="object.is_overdue">
        This is a reminder that the following payment is <strong>overdue</strong>:
    </p>
    <p t-else="">
        This is a friendly reminder that the following payment is due soon:
    </p>
    <table style="border-collapse: collapse; margin: 12px 0;">
        <tr><td style="padding: 4px 12px 4px 0;">Project / Unit</td>
            <td style="padding: 4px 0;"><strong t-out="object.unit_id.display_name or object.project_id.name or ''"/></td></tr>
        <tr><td style="padding: 4px 12px 4px 0;">Installment</td>
            <td style="padding: 4px 0;"><strong t-out="object.name"/></td></tr>
        <tr><td style="padding: 4px 12px 4px 0;">Due date</td>
            <td style="padding: 4px 0;"><strong t-out="format_date(object.due_date)"/></td></tr>
        <tr><td style="padding: 4px 12px 4px 0;">Amount due</td>
            <td style="padding: 4px 0;"><strong t-out="format_amount(object.amount_residual, object.currency_id)"/></td></tr>
        <tr t-if="object.invoice_id"><td style="padding: 4px 12px 4px 0;">Invoice</td>
            <td style="padding: 4px 0;"><strong t-out="object.invoice_id.name"/></td></tr>
    </table>
    <p t-if="object.invoice_id">
        <a t-att-href="object.invoice_id.get_portal_url()"
           style="background-color: #875A7B; padding: 8px 16px; color: #ffffff; text-decoration: none; border-radius: 5px;">
            View &amp; Pay Invoice
        </a>
    </p>
    <p>If you have already made this payment, please disregard this message.</p>
    <p>Kind regards,<br/><t t-out="object.company_id.name or ''"/></p>
</div>
        </field>
    </record>
</odoo>
